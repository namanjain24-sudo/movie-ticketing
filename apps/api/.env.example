# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=4000

# Postgres 16 and Redis 7 run locally as Homebrew services (no Docker needed).
# SQLite is not an option: the booking mechanic needs SELECT ... FOR UPDATE.
#
# The `options=-c timezone=UTC` is not decoration. Prisma maps DateTime to
# `timestamp without time zone`, so a session on a non-UTC timezone shifts every
# value on the round trip and the whole expiry model silently breaks. Pinning it
# on the connection makes the app independent of how the server was initialised.
DATABASE_URL="postgresql://ticketing:ticketing@localhost:5432/ticketing?options=-c%20timezone%3DUTC"
DATABASE_POOL_MAX=20
REDIS_URL="redis://localhost:6379"

# Generate each with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string-at-least-32-chars
JWT_REFRESH_SECRET=replace-me-with-a-different-long-random-string-32-chars

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Comma-separated. Expo dev server and web origins.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
LOG_LEVEL=debug

# --- Booking mechanic --------------------------------------------------------
HOLD_TTL_SECONDS=300
MAX_SEATS_PER_BOOKING=10
BOOKING_FEE_MINOR=3000
CANCELLATION_WINDOW_MINUTES=120
SWEEPER_INTERVAL_SECONDS=15
SWEEPER_ENABLED=true

# --- Payments ----------------------------------------------------------------
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=replace-me-with-a-random-webhook-secret
MOCK_PAYMENT_FAILURE_RATE=0.1
MOCK_PAYMENT_LATENCY_MS=120
IDEMPOTENCY_TTL_SECONDS=86400

# --- Rate limits (per IP) ----------------------------------------------------
# Raise these for a load run; the defaults are the production values.
RATE_LIMIT_GLOBAL_PER_MINUTE=120
RATE_LIMIT_HOLD_PER_MINUTE=30
RATE_LIMIT_AUTH_PER_15_MINUTES=10

# Enables /v1/_chaos, used by `npm run chaos`. Never true in production; the
# API refuses to boot if it is.
CHAOS_CONTROLS_ENABLED=false

# --- Catalogue artwork -------------------------------------------------------
# Optional, and only read by `npm run catalogue`, never by the running server.
#
# Without it the catalogue falls back to Wikipedia's lead images: real posters,
# but fair-use files under 300px wide, which a phone screen upscales about three
# times. With it, posters come off TMDB's CDN at 780px and films get backdrops
# as well. Free key: https://www.themoviedb.org/settings/api
#
# Either credential works — the v3 "API Key" (32 hex characters) or the v4
# "Read Access Token" (a long JWT). The fetcher detects which one it has.
TMDB_API_KEY=
